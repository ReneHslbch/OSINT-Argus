from app.tools.leak_tools import check_hibp


class LeakAgent(BaseAgent):

    def run(self, state):
        target = state.get("current_check")

        result = check_hibp.invoke({
            "email": target
        })

        finding = Findings(
            agent=AgentType.LEAK,
            input=target,
            threat_sum=[
                f"{len(result.get('breaches', []))} Breaches gefunden"
            ],
            vulnerability_sum=result.get(
                "breaches",
                []
            )
        )

        state["findings"].append(finding)

        return state
