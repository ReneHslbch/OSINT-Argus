import os
import httpx
from langchain_core.tools import tool

@tool
def check_hibp(email: str):
    """
    Prüft eine E-Mail-Adresse gegen HaveIBeenPwned.
    """

    api_key = os.getenv("HIBP_API_KEY")

    url = (
        f"https://haveibeenpwned.com/api/v3/"
        f"breachedaccount/{email}"
    )

    headers = {
        "hibp-api-key": api_key,
        "user-agent": "osint-argus"
    }

    try:
        response = httpx.get(
            url,
            headers=headers,
            timeout=15
        )

        if response.status_code == 404:
            return {
                "breaches": []
            }

        response.raise_for_status()

        breaches = response.json()

        return {
            "breaches": [
                f"{b['Name']} ({b['BreachDate']})"
                for b in breaches
            ]
        }

    except Exception as e:
        return {
            "error": str(e),
            "breaches": []
        }
