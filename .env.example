# =============================================================================
# OSINT-Argus - Environment Configuration
# =============================================================================
# Kopiere diese Datei nach .env und f\u00FClle die Werte aus.
# NIEMALS .env in Git committen!
# =============================================================================

# ── LLM-Konfiguration (OpenAI-kompatibles API) ────────────────────────────────

# API-Schl\u00FCssel f\u00FCr das LLM-Backend
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Basis-URL des LLM-Endpunkts (mit /v1 Suffix)
OPENAI_BASE_URL=https://chat-ai.academiccloud.de/v1

# Zu verwendendes Modell (muss vom Backend unterst\u00FCtzt werden)
# Beispiele: mistral-large-instruct, mistral-large-3-675b-instruct-2512, etc.
MODEL_NAME=mistral-large-instruct

# ── OSINT-API-Schl\u00FCssel ──────────────────────────────────────────────────────

# VirusTotal API-Key (https://www.virustotal.com/)
VT_API_KEY=YOUR_VIRUSTOTAL_API_KEY

# Shodan API-Key (https://www.shodan.io/)
SHODAN_API_KEY=YOUR_SHODAN_API_KEY

# Have I Been Pwned API-Key (https://haveibeenpwned.com/)
# Hinweis: HIBP API erfordert oft Premium-Zugang
HIBP_API_KEY=YOUR_HIBP_API_KEY

# GitHub Token (f\u00FCr CVE-Suchen und Repository-Checks)
GITHUB_TOKEN=YOUR_GITHUB_PAT

# ── Mailbox Watcher Konfiguration ─────────────────────────────────────────────
# Fester "Weiterleiten-und-Analysieren"-Postfach-Service (IMAP/SMTP)

# IMAP-Einstellungen (E-Mail Abruf)
MONITOR_MAILBOX_IMAP_SERVER=imap.gmail.com
MONITOR_MAILBOX_IMAP_PORT=993
MONITOR_MAILBOX_ADDRESS=your-email@gmail.com
MONITOR_MAILBOX_PASSWORD=your-app-password

# SMTP-Einstellungen (E-Mail Versand)
MONITOR_SMTP_SERVER=smtp.gmail.com
MONITOR_SMTP_PORT=587
MONITOR_SMTP_USE_TLS=true

# Mailbox-Zugangspasswort (f\u00FCr lokale UI-Best\u00E4tigung)
MAILBOX_PASSWORD=your-local-access-password

# IMAP-Einstellungen
MONITOR_MAILBOX_USE_SSL=true
MONITOR_MAILBOX_FOLDER=INBOX

# ── Rate-Limiting ─────────────────────────────────────────────────────────────
# Schutz vor Missbrauch des Mailbox-Service

# Maximale Analysen pro Absenderadresse innerhalb des Zeitfensters
RATE_LIMIT_MAX_ANALYSES_PER_SENDER=5

# Zeitfenster in Stunden f\u00FCr Rate-Limiting
RATE_LIMIT_WINDOW_HOURS=24

# ── Polling & Performance ─────────────────────────────────────────────────────

# Intervall (in Sekunden) zwischen IMAP-Polls
MAILBOX_POLL_INTERVAL_SECONDS=60

# Maximale Anh\u00E4ngegr\u00F6\u00DFe in Bytes (Standard: 10 MB)
MAX_ATTACHMENT_SIZE_BYTES=10485760

# ── Mailbox Watcher Mode ──────────────────────────────────────────────────────
# Steuert das Verhalten des automatischen Mail-Analysis

# true  = Alle neuen Mails automatisch analysieren (Standard)
# false = Keine automatische Analyse; Mails bleiben im Postfach f\u00FCr manuelle
#         Analyse \u00FCber die Streamlit-UI (Access-Key erforderlich)
MAILBOX_AUTO_ANALYZE=true

# ── Optional: Tempor\u00E4rer Ordner f\u00FCr Anh\u00E4nge ────────────────────────────────────
# Pfad f\u00FCr tempor\u00E4re Anh\u00E4nge w\u00E4hrend der Analyse (Standard: System-Temp)
# MAILBOX_TEMP_DIR=/path/to/temp/dir
